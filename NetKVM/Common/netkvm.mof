// Declaration of NetKvm WMI OID
#pragma namespace("\\\\.\\root\\wmi")
#pragma classflags("forceupdate")
#pragma autorecover

[Dynamic : ToInstance, Provider("WMIProv"), WMI,
guid("{234E1FBF-37DC-4882-B01E-18F47CC0A40E}"),
Description("Debug logging configuration")]
class NetKvm_Logging : MSNdis
{
    [key, read] string InstanceName;
    [read] boolean Active;
    [read,write,WmiDataId(1),
     Description("Debug output verbosity level")] uint32 level;
};

[Dynamic : ToInstance, Provider("WMIProv"), WMI,
guid("{FED9CC79-5742-48F3-92C4-11698BD750E7}"),
Description("Reset diagnostic statistics counters")]
class NetKvm_DiagReset : MSNdis
{
    [key, read] string InstanceName;
    [read] boolean Active;
// bit 0 - rx, bit 1 - tx, bit 2 - rss
    [read,write,WmiDataId(1),
     Description("Bitmask of counters to reset: bit 0 - RX, bit 1 - TX, bit 2 - RSS")] uint8 type;
};

[Dynamic : ToInstance, Provider("WMIProv"), WMI,
guid("{8F4D3DFA-06C0-4520-88C1-5F18184BEB09}"),
Description("Device-level RSS (Receive Side Scaling) control")]
class NetKvm_DeviceRss : MSNdis
{
    [key, read] string InstanceName;
    [read] boolean Active;
    [read,write,WmiDataId(1),
     Description("Enable or disable device RSS support")] boolean value;
};

[Dynamic : ToInstance, Provider("WMIProv"), WMI,
guid("{DDA1EC5D-1CA9-448D-8B19-1F7E57180DAD}"),
Description("Adapter configuration and resource information")]
class NetKvm_Config : MSNdis
{
    [key, read] string InstanceName;
    [read] boolean Active;
    [WmiDataId(1), read,
     Description("Number of virtqueue path bundles, static after initialization")] uint32 NumOfQueues;
    [WmiDataId(2), read,
     Description("Number of free RX buffers in queue 0, changes during operation")] uint32 RxQueueSize;
    [WmiDataId(3), read,
     Description("Actual TX queue size of queue 0, static after initialization")] uint32 TxQueueSize;
    [WmiDataId(4), read,
     Description("RSC (Receive Segment Coalescing) enabled for IPv4, may change via offload parameters")] boolean RscEnabledv4;
    [WmiDataId(5), read,
     Description("RSC (Receive Segment Coalescing) enabled for IPv6, may change via offload parameters")] boolean RscEnabledv6;
    [WmiDataId(6), read,
     Description("VIRTIO_NET_F_STANDBY feature negotiated, static after initialization")] boolean Standby;
    [WmiDataId(7), read,
     Description("Allocated shared memory in kilobytes, stabilizes after lazy allocation")] uint32 MemoryKB;
    [WmiDataId(8), read,
     Description("Fast initialization time in milliseconds, static after initialization")] sint32 InitTimeMs;
    [WmiDataId(9), read,
     Description("Lazy allocation time in milliseconds, -1 until lazy allocation completes")] sint32 LazyAllocTimeMs;
    [WmiDataId(10), read,
     Description("USO (UDP Segmentation Offload) enabled for IPv4, may change via offload parameters")] sint32 UsoEnabledv4;
    [WmiDataId(11), read,
     Description("USO (UDP Segmentation Offload) enabled for IPv6, may change via offload parameters")] sint32 UsoEnabledv6;
};

[WMI,
guid("{09880234-BCB9-4D9D-BCE6-135640671630}"),
Description("Transmit path statistics")]
class NetKvm_Tx
{
    [WmiDataId(1), read,
     Description("Frames sent using LSO (Large Send Offload)")] uint32 LargeOffload;
    [WmiDataId(2), read,
     Description("Frames sent using USO (UDP Segmentation Offload)")] uint32 UdpOffload;
    [WmiDataId(3), read,
     Description("Frames sent using checksum offload")] uint32 ChecksumOffload;
    [WmiDataId(4), read,
     Description("Minimum observed free TX buffers")] uint32 MinFreeBuffers;
    [WmiDataId(5), read,
     Description("TX packets copied")] uint32 Copied;
    [WmiDataId(6), read,
     Description("TX packets dropped")] uint32 Dropped;
};

[WMI,
 guid("{DEE2E74A-45B5-4CAF-B3F7-EE90660F1A70}"),
Description("Receive path statistics")]
class NetKvm_Rx
{
    [read,WmiDataId(1),
     Description("Frames coalesced by Windows RSC")] uint32 CoalescedWin;
    [read,WmiDataId(2),
     Description("Frames coalesced by host")] uint32 CoalescedHost;
    [read,WmiDataId(3),
     Description("Frames with checksum validated OK by the VirtIO device")] uint32 ChecksumOK;
    [read,WmiDataId(4),
     Description("Frames received with nonzero 802.1Q priority or VLAN ID")] uint32 Priority;
    [read,WmiDataId(5),
     Description("Minimum observed free RX buffers")] uint32 MinFreeBuffers;
    [read,WmiDataId(6),
     Description("RX indications with low resources flag")] uint32 LowResources;
};

[WMI,
guid("{7C03D07F-52FA-4C2F-8A85-9F24D575C518}"),
Description("Receive Side Scaling statistics")]
class NetKvm_Rss
{
    [read,WmiDataId(1),
     Description("Device supports RSS persistently, static after initialization")] boolean DeviceRssSupport;
    [read,WmiDataId(2),
     Description("Device reports hash values, static after initialization")] boolean DeviceHashSupport;
    [read,WmiDataId(3),
     Description("Driver's Device RSS setting; may not reflect device state")] boolean DeviceRssOn;
    [read,WmiDataId(4),
     Description("Frames processed on the target receive queue")] uint32 Hits;
    [read,WmiDataId(5),
     Description("Frames redirected to the target receive queue")] uint32 Misses;
    [read,WmiDataId(6),
     Description("Frames not classified by RSS")] uint32 Unclassified;
    [read,WmiDataId(7),
     Description("RSS classification errors")] uint32 Errors;
};

[WMI,
guid("{A76B478A-3485-49D0-B0A9-E61E17930578}"),
Description("Control virtqueue statistics")]
class NetKvm_Ctrl
{
    [read,WmiDataId(1),
     Description("Total control commands attempted")] uint32 Commands;
    [read,WmiDataId(2),
     Description("Control commands that timed out")] uint32 CommandsTimedOut;
    [read,WmiDataId(3),
     Description("Control commands that failed")] uint32 CommandsFailed;
};

[Dynamic : ToInstance, Provider("WMIProv"), WMI,
guid("{85888FE2-CBCE-4857-A512-4694CF5B2797}"),
Description("Adapter diagnostic statistics")]
class NetKvm_Diag : MSNdis
{
    [key, read] string InstanceName;
    [read] boolean Active;
    [read,WmiDataId(1),
     Description("Transmit statistics")] NetKvm_Tx tx;
    [read,WmiDataId(2),
     Description("Receive statistics")] NetKvm_Rx rx;
    [read,WmiDataId(3),
     Description("RSS statistics")] NetKvm_Rss rss;
    [read,WmiDataId(4),
     Description("Control virtqueue statistics")] NetKvm_Ctrl ctrl;
};
