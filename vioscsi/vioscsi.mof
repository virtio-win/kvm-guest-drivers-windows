[
    Dynamic, Provider("WMIProv"),
    WMI,
    Description ("VirtIO SCSI Extended Information"),
    guid ("{5CDAC4F6-3D46-44E2-8DEE-01606E11E265}"),
    HeaderName("VioScsiExtendedInfo"),
    GuidName1("VioScsiWmi_ExtendedInfo_Guid"),
    WmiExpense(0)
]
class VioScsiExtendedInfoGuid
{
    [read,key] String InstanceName;
    [read] boolean Active;

    [read, WmiDataId(1), WmiVersion(1),
     Description("Per-LUN queue depth, static after initialization")] uint32 QueueDepth;
    [read, WmiDataId(2), WmiVersion(1),
     Description("Number of request virtqueues, static after initialization")] uint8  QueuesCount;
    [read, WmiDataId(3), WmiVersion(1),
     Description("VIRTIO_RING_F_INDIRECT_DESC feature negotiated, static after initialization")] boolean Indirect;
    [read, WmiDataId(4), WmiVersion(1),
     Description("VIRTIO_RING_F_EVENT_IDX feature negotiated, static after initialization")] boolean EventIndex;
    [read, WmiDataId(5), WmiVersion(1),
     Description("STOR_PERF_DPC_REDIRECTION optimization active, static after initialization")] boolean DpcRedirection;
    [read, WmiDataId(6), WmiVersion(1),
     Description("STOR_PERF_CONCURRENT_CHANNELS optimization active, static after initialization")] boolean ConcurrentChannels;
    [read, WmiDataId(7), WmiVersion(1),
     Description("STOR_PERF_INTERRUPT_MESSAGE_RANGES optimization active, static after initialization")] boolean InterruptMsgRanges;
    [read, WmiDataId(8), WmiVersion(1),
     Description("STOR_PERF_OPTIMIZE_FOR_COMPLETION_DURING_STARTIO optimization active, static after initialization")] boolean CompletionDuringStartIo;
    [read, WmiDataId(9), WmiVersion(1),
     Description("VIRTIO_F_RING_PACKED feature negotiated, static after initialization")] boolean RingPacked;
    [read, WmiDataId(10), WmiVersion(1),
     Description("Maximum physical breaks per transfer, static after initialization")] uint32 PhysicalBreaks;
    [read, WmiDataId(11), WmiVersion(1),
     Description("Response time tracing threshold in milliseconds from registry, 0 if disabled, static after initialization")] uint32 ResponseTime;
};
